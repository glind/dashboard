# Example configuration file
# Copy this to config.yaml and customize as needed

# Application settings
environment: "development"
debug: true
log_level: "INFO"
data_retention_days: 90
collection_interval_hours: 6

# Ollama configuration
ollama:
  host: "localhost"
  port: 11434
  model: "llama2"

# Google APIs
google:
  credentials_file: "config/google_credentials.json"
  scopes:
    - "https://www.googleapis.com/auth/gmail.readonly"
    - "https://www.googleapis.com/auth/calendar.readonly"

# Apple settings
apple:
  reminders_export_path: "data/apple_reminders.csv"

# Task sync settings
task_sync:
  enabled: true
  default_provider: "ticktick"
  provider_order:
    - "ticktick"
    - "apple_reminders"
    - "todoist"
  apple_reminders_list: "Inbox"

# Notes settings
notes:
  obsidian:
    enabled: true
    vault_path: "/Users/yourusername/Documents/ObsidianVault"  # Update with your Obsidian vault path
    recent_days: 7  # Only check notes modified in last N days
  google_drive:
    enabled: true
    meeting_notes_folder_id: ""  # Google Drive folder ID for meeting notes
    credentials_file: "config/google_credentials.json"

# Dashboard settings
dashboard:
  output_dir: "output"
  template_dir: "templates"
  static_dir: "static"
  weekly_goals:
    emails_processed: 100
    meetings_attended: 10
    tasks_completed: 20
    github_commits: 15
  monthly_goals:
    emails_processed: 400
    meetings_attended: 40
    tasks_completed: 80
    github_commits: 60

# Voice system settings (Rogr assistant - NVIDIA PersonaPlex)
# Enable with: export PERSONAPLEX_ENABLED=true
# See devdocs/VOICE_SYSTEM.md for full setup
voice:
  enabled: true

  # Offline voice engine:
  #   - piper (default, binary-based, lightweight)
  #   - coqui (python package, richer voice options)
  engine: "piper"

  # Coqui model config (used when engine=coqui)
  # Default model: tts_models/en/ljspeech/tacotron2-DDC (works without system espeak)
  # Multi-speaker option: tts_models/en/vctk/vits (requires system espeak/espeak-ng)
  coqui_model: "tts_models/en/ljspeech/tacotron2-DDC"
  # Optional fixed speaker/language override
  coqui_speaker: null
  coqui_language: null
  
  # PersonaPlex server URL (start server separately)
  server_url: "wss://localhost:8998"

  # Voice preset - choose from:
  #   Natural female: NATF0, NATF1, NATF2, NATF3
  #   Natural male:   NATM0, NATM1, NATM2, NATM3  (NATM1 = default)
  #   Variety female: VARF0, VARF1, VARF2, VARF3, VARF4
  #   Variety male:   VARM0, VARM1, VARM2, VARM4
  voice_preset: "NATM1"

  # Voice style/effect to apply
  # Options: clean, droid, radio, pa_system, cinematic, glitch
  default_style: "droid"
  
  # Persona/role for the assistant
  # Options: rogr, assistant, casual (or custom prompt)
  persona: "rogr"
  
  # When to announce
  announce_on_startup: true
  announce_on_collection: true
  announce_on_error: false
  
  # Wake words for voice commands (optional - requires PyAudio)
  wake_words:
    - "rogr"
    - "roger"
  
  # Signature phrase added to announcements
  signature_phrase: "roger, roger"


# Holiday themes (Buster design system seasons) for every skin / both UIs.
# Defaults come from src/static/ds/seasons.json; uncomment to change the calendar.
# Window format: {season: halloween|thanksgiving|winter, variant: newyear (optional),
# start: "MM-DD", end: "MM-DD"}; inclusive; end < start wraps over New Year; first match wins.
# Each person can still pick auto/none/a season in Settings > Theme & Holidays, and ?season= previews.
# seasons:
#   enabled: true
#   windows:
#     - {season: winter, variant: newyear, start: "12-31", end: "01-01"}
#     - {season: halloween, start: "10-01", end: "11-01"}
#     - {season: thanksgiving, start: "11-02", end: "11-30"}
#     - {season: winter, start: "12-01", end: "01-06"}
